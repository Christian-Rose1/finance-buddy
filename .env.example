# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Your team's shared Supabase project. Get these from the Supabase Dashboard
# → Project Settings → API. The anon key is safe to expose to the browser
# (Row-Level Security protects your data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Strategy engine (optional)
# ---------------------------------------------------------------------------
# The strategy engine defaults to local Ollama when no cloud provider is
# configured. Set OPENROUTER_API_KEY to switch to OpenRouter (cloud).
OPENROUTER_API_KEY=

# Optional model overrides.
# OPENROUTER_RESEARCH_MODEL -- defaults to "openrouter/free"
# OPENROUTER_STRATEGY_MODEL
OPENROUTER_RESEARCH_MODEL=
OPENROUTER_STRATEGY_MODEL=

# Research interpreter: "ollama" (default) or "openrouter".
STRATEGY_RESEARCH_PROVIDER=

# Tavily web-search API key (required for research queries that search the web).
TAVILY_API_KEY=

# Local Ollama (used when OPENROUTER_API_KEY is absent).
# OLLAMA_BASE_URL defaults to http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_STRATEGY_MODEL=
OLLAMA_RECEIPT_MODEL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Set to "1" to enable verbose strategy-engine debug logging.
STRATEGY_DEBUG=

# Required when generating or reading persisted goal strategies. This is a
# server secret: share it only through the team's secret manager, never Git.
# It must be ≥ 32 characters. Generate with: openssl rand -hex 32
STRATEGY_RUN_SIGNING_SECRET=
